{
  "name": "tools-and-scripts-protection",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": { "include": ["main", "dev"], "exclude": [] }
  },
  "rules": [
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "required_status_checks": [
          "lint",
          "test"
        ],
        "strict_required_status_checks_policy": false
      }
    },
    {
      "type": "non_fast_forward"
    }
  ],
  "metadata": {
    "version": "1.0.0",
    "created": "2026-02-05",
    "updated": "2026-02-05",
    "description": "Standard protection rules for utility tools and scripts with linting and testing requirements",
    "tags": ["tools", "scripts", "utilities", "standard"]
  }
}
