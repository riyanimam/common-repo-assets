{
  "name": "open-source-project-ruleset",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": { "include": ["main", "develop"], "exclude": [] }
  },
  "rules": [
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": true,
        "require_last_push_approval": false
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "required_status_checks": [
          "ci-build",
          "test",
          "lint",
          "DCO"
        ],
        "strict_required_status_checks_policy": true
      }
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "commit_message_pattern",
      "parameters": {
        "name": "Conventional Commits",
        "pattern": "^(feat|fix|docs|style|refactor|perf|test|build|ci|chore)(\\(.+\\))?: .+",
        "operator": "matches",
        "negate": false
      }
    }
  ],
  "metadata": {
    "version": "1.0.0",
    "created": "2026-02-05",
    "updated": "2026-02-05",
    "description": "Balanced protection for open-source projects with maintainer approval, CI checks, and conventional commits",
    "tags": ["open-source", "community", "balanced", "conventional-commits"]
  }
}
