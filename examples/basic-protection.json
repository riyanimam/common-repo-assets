{
  "name": "basic-protection",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": { "include": ["main"], "exclude": [] }
  },
  "rules": [
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1
      }
    },
    {
      "type": "non_fast_forward"
    }
  ],
  "metadata": {
    "version": "1.0.0",
    "created": "2026-02-05",
    "updated": "2026-02-05",
    "description": "Minimal protection requiring one approval and preventing force pushes",
    "tags": ["basic", "simple", "starter"]
  }
}
